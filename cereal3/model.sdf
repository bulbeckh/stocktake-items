          </mesh>
        </geometry>
		</visual>

	<!-- TODO Update inertial properties -->
	<inertial>
		<mass>0.2</mass>
		<inertia>
		    <ixx>0.0015817</ixx>
			<iyy>0.0021667</iyy>
			<izz>0.0007483</izz>
			<ixy>0.0</ixy>
			<ixz>0.0</ixz>
			<iyz>0.0</iyz>
		</inertia>
	</inertial>
    </link>
  </model>
</sdf>

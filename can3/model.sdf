<?xml version="1.0"?>
<sdf version="1.9">
  <model name="can3">
	<static>false</static>

	<link name="link">
      <collision name="collision">
		  <geometry>
			  <cylinder>
				  <radius>0.05</radius>
				  <length>0.15</length>
			  </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
	  <pose degrees="true">0 0 0 90 0 0</pose>
        <geometry>
          <mesh>
            <uri>./meshes/can3.glb</uri>
          </mesh>
	  </geometry>
	</visual>

	<!-- TODO Update inertial properties -->
	<inertial>
		<mass>0.2</mass>
		<inertia>
		    <ixx>0.0015817</ixx>
			<iyy>0.0021667</iyy>
			<izz>0.0007483</izz>
			<ixy>0.0</ixy>
			<ixz>0.0</ixz>
			<iyz>0.0</iyz>
		</inertia>
	</inertial>
    </link>
  </model>
</sdf>
